{
  "name": "ranona-bot",
  "version": "1.0.0",
  "description": "Ranona - Telegram Bot for Music, Games, Protection and Fun",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "migrate": "supabase db push"
  },
  "keywords": [
    "telegram",
    "bot",
    "ranona",
    "music",
    "games",
    "protection",
    "supabase"
  ],
  "author": "Ranona",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "telegraf": "^4.16.3",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1"
  }
}
